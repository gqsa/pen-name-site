# .env — LOCAL environment variables (A1: env-only secrets)
#
# HOW TO USE:
#   1. Copy this file to ".env"  (same folder)
#   2. Fill in real values
#   3. NEVER commit .env — it's in .gitignore. This .env.example is the safe
#      placeholder that IS committed, so you (and future-you) know what's needed.
#
# On Render you set these in the dashboard / render.yaml instead of a .env file.

# Signs your session cookies. MUST be a long random string in production.
# (Render generates one for you via render.yaml: SESSION_SECRET generateValue.)
SESSION_SECRET=please-replace-with-a-long-random-string-at-least-32-chars

# PayPal SANDBOX (test mode) credentials — from developer.paypal.com.
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Your app's public URL (PayPal uses it to know where to send users back).
# Local: http://localhost:3000 — Render: https://YOUR-SERVICE.onrender.com
APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# A2: recurring membership (PayPal Subscriptions)
# ---------------------------------------------------------------------------
# The WEBHOOK ID — from the PayPal dashboard, Webhooks tab (the id of the
# webhook you pointed at https://YOUR-SERVICE.onrender.com/paypal-webhook).
# Our server verifies every webhook's RSA signature against this id; without a
# valid one, membership events are rejected.
PAYPAL_WEBHOOK_ID=your-webhook-id

# What the subscription sells. Changing price/period only affects NEW
# subscribers (existing ones keep the plan they signed up under).
SUBSCRIPTION_NAME=gqsa membership
SUBSCRIPTION_PRICE=1.00
SUBSCRIPTION_CURRENCY=USD
SUBSCRIPTION_PERIOD=MONTH

# ---------------------------------------------------------------------------
# B2: admin area
# ---------------------------------------------------------------------------
# The site owner's username — the ONLY account that can access /admin
# (implementation tracker + the comic / story editors). Leave empty to disable
# the admin area entirely.
ADMIN_USERNAME=your-owner-username
# The admin's password. Used ONLY to create the account at boot when it's
# missing (e.g. after a Render free-tier disk wipe — database.db is gone,
# env vars are not, so this is how the admin survives redeploys). An existing
# account is NEVER overwritten, so a locally-changed password always wins.
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# A3: accounts & email
# ---------------------------------------------------------------------------
# Email at account creation. false (default for now) = the field is shown and
# collected but a blank email still registers; true = a valid email is
# REQUIRED to register. Flipping this line IS the "no optional email"
# migration — the field, settings page, and reset flow all exist already.
EMAIL_REQUIRED=false
# Where the site's emails go (THE ONE PATHWAY — see the A3 section in
# server.js). Every email (resets, member blasts, receipts) uses this:
#   console — log each email to the server output (zero setup; on Render,
#             visible in the web-service logs).
#   file    — append each email to a JSON outbox you can open and read
#             (great for local inspection; the test suite uses it).
# A real provider (Resend/SMTP) becomes a third branch in the C1 era.
EMAIL_TRANSPORT=console
# Only used when EMAIL_TRANSPORT=file. Kept out of git by .gitignore.
EMAIL_FILE_PATH=.mailoutbox.json
# The "From" address shown on outgoing mail (a real sender domain comes with C1).
EMAIL_FROM=gqsa <hello@gqsa.site>
