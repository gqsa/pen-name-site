<%- include('partials/head', { title: 'Register' }) %>
  <div class="wrap">
    <div class="card">
      <h1>Create account</h1>
      <form action="/register" method="POST">
        <!-- A1: hidden CSRF field — the anti-forgery token for THIS session -->
        <input type="hidden" name="csrf" value="<%= csrfToken %>">

        <label>Username</label>
        <input type="text" name="username" required placeholder="Choose a username" autocomplete="username">

        <label>Password</label>
        <input type="password" name="password" required placeholder="Choose a password" autocomplete="new-password">

        <button type="submit">Register</button>
      </form>

      <p class="muted"><a href="/">Back to home</a></p>
    </div>
  </div>
<%- include('partials/footer') %>
