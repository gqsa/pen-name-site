<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= (typeof title !== 'undefined' && title) ? title : 'gqsa' %></title>
  <style>
    :root { --accent:#0a7d33; --bg:#fafafa; --ink:#1c1c1c; --muted:#666; --line:#e2e2e2; }
    * { box-sizing: border-box; }
    body { font-family: Arial, Helvetica, sans-serif; margin:0; background:var(--bg); color:var(--ink); line-height:1.55; }
    a { color: var(--accent); text-decoration:none; }
    a:hover { text-decoration: underline; }
    .wrap { max-width: 460px; margin: 40px auto; padding: 0 16px; }
    .center { text-align: center; padding: 60px 16px; }
    .card { background:#fff; border:1px solid var(--line); border-radius:10px; padding:22px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    h1 { font-size: 1.6rem; margin:.2em 0 .6em; }
    label { display:block; font-weight:600; margin-top:12px; }
    input, select, textarea { display:block; width:100%; padding:10px; margin:6px 0 2px; border:1px solid #ccc; border-radius:6px; font:inherit; background:#fff; }
    button { padding:11px 18px; background:var(--accent); color:#fff; border:none; border-radius:6px; cursor:pointer; font:inherit; font-weight:600; }
    button:hover { filter:brightness(1.06); }
    button:disabled { opacity:.55; cursor:default; }
    .muted { color:var(--muted); }
    .error { color:#b00020; }
    .success { color:var(--accent); }
    .row { display:flex; gap:10px; flex-wrap:wrap; align-items:center; }
    .panel { border:1px solid var(--line); border-radius:8px; padding:14px; margin-top:18px; }
    .panel--member { background:#f0fff4; border-color:#9ae6b4; }
    .panel--warn { background:#fffaf0; border-color:#f6ad55; }
    .btn--danger { background:#c53030; color:#fff; }
    .btn--danger:hover { background:#a52525; }
    .checklist { list-style:none; padding:0; }
    .checklist li { margin:8px 0; display:flex; align-items:center; gap:8px; }
    .checklist input[type=checkbox] { width:auto; margin:0; }
  </style>
</head>
<body>
