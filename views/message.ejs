<%- include('partials/head', { title: (typeof title !== 'undefined' && title) ? title : 'gqsa' }) %>
  <div class="center">
    <h1 class="<%= (typeof tone !== 'undefined' && tone) ? tone : '' %>"><%= heading %></h1>
    <% if (typeof body !== 'undefined' && body) { %><p><%- body %></p><% } %>
    <% if (typeof linkHref !== 'undefined' && linkHref) { %><p><a href="<%= linkHref %>"><%= linkText %></a></p><% } %>
    <% if (typeof link2Href !== 'undefined' && link2Href) { %><p><a href="<%= link2Href %>"><%= link2Text %></a></p><% } %>
  </div>
<%- include('partials/footer') %>
